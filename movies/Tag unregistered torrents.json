{
  "_slug": "tag-unregistered-torrents",
  "name": "Tag: unregistered torrents",
  "trackerPattern": "*",
  "trackerDomains": null,
  "conditions": {
    "schemaVersion": "1",
    "tag": {
      "enabled": true,
      "tags": [
        "~del_unregistered"
      ],
      "mode": "full",
      "condition": {
        "operator": "AND",
        "conditions": [
          {
            "field": "STATE",
            "operator": "NOT_EQUAL",
            "value": "stalled_downloading"
          },
          {
            "field": "STATE",
            "operator": "NOT_EQUAL",
            "value": "tracker_down"
          },
          {
            "operator": "OR",
            "conditions": [
              {
                "field": "IS_UNREGISTERED",
                "operator": "EQUAL",
                "value": "true"
              },
              {
                "operator": "AND",
                "conditions": [
                  {
                    "field": "TRACKER",
                    "operator": "CONTAINS",
                    "value": "tracker.beyond-hd"
                  },
                  {
                    "field": "STATE",
                    "operator": "EQUAL",
                    "value": "tracker_error"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "tags": [
      {
        "enabled": true,
        "tags": [
          "~del_unregistered"
        ],
        "mode": "full",
        "condition": {
          "operator": "AND",
          "conditions": [
            {
              "field": "STATE",
              "operator": "NOT_EQUAL",
              "value": "stalled_downloading"
            },
            {
              "field": "STATE",
              "operator": "NOT_EQUAL",
              "value": "tracker_down"
            },
            {
              "operator": "OR",
              "conditions": [
                {
                  "field": "IS_UNREGISTERED",
                  "operator": "EQUAL",
                  "value": "true"
                },
                {
                  "operator": "AND",
                  "conditions": [
                    {
                      "field": "TRACKER",
                      "operator": "CONTAINS",
                      "value": "tracker.beyond-hd"
                    },
                    {
                      "field": "STATE",
                      "operator": "EQUAL",
                      "value": "tracker_error"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "intervalSeconds": 900,
  "sortOrder": 11
}